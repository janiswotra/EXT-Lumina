{
  "name": "yena-candidate-clipper",
  "version": "1.0.36",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bump": "node -e \"const m=require('./manifest.json');const v=m.version.split('.');v[2]=+v[2]+1;m.version=v.join('.');require('fs').writeFileSync('./manifest.json',JSON.stringify(m,null,2)+'\\n');console.log('Bumped to',m.version)\"",
    "build": "npm run bump && tsc && vite build && vite build -c vite.content.config.ts && vite build -c vite.contentApp.config.ts && vite build -c vite.contentMessages.config.ts",
    "build:host": "vite build -c vite.host.config.ts",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.37",
    "@types/node": "^25.3.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vite-plugin-static-copy": "^1.0.0"
  }
}
