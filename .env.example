# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# NOTE: The static extension itself needs NO secrets — the domain + token are
# entered in the extension popup at runtime. These vars are only for tooling
# (the app/ deploy script and any local Supabase work).

# --- Extension UI deploy (app/deploy.mjs) ---
# Target Yena domain the iframe UI is hosted on.
YENA_DOMAIN=https://demo.yena.ai
# Deploy token accepted by yena-ats server.js (x-deploy-token header).
EXTENSION_DEPLOY_TOKEN=

# --- Demo environment ---
VITE_API_BASE_URL_DEMO=
VITE_SUPABASE_ANON_KEY_DEMO=
VITE_APP_DOMAIN_DEMO=

# --- Production environment ---
VITE_API_BASE_URL_PROD=
VITE_SUPABASE_ANON_KEY_PROD=
VITE_APP_DOMAIN_PROD=

# --- Supabase CLI ---
SUPABASE_ACCESS_TOKEN=
