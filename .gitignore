# Dependencies
node_modules/
**/node_modules/

# Secrets — never commit real values, use .env.example as the template
.env
.env.*
!.env.example

# Build output (npm run build: src/ -> dist/)
dist/

# Chrome-generated artifact when loading the unpacked extension
src/_metadata/
dist/_metadata/

# The store-ready zip (npm run build) is tracked on purpose; only the dev variant
# (npm run build:dev, carries localhost host permissions) must never reach the repo.
yena-clipper-dev.zip

# Misc
*.log
.DS_Store
